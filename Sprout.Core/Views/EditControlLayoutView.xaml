<UserControl x:Class="Sprout.Core.Views.EditControlLayoutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Sprout.Core.Views"
             xmlns:config="clr-namespace:Sprout.Core.Models.Configurations"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance config:SproutControlConfig}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!--Row-->
        <TextBlock
            Grid.Row="0"
            Grid.Column="0"
            Margin="5"
            VerticalAlignment="top"
            Text="Row"
            FontWeight="Bold"
            FontSize="16"/>

        <TextBox
            Grid.Row="0"
            Grid.Column="1"
            VerticalAlignment="top"
            Margin="5"
            Text="{Binding Row, UpdateSourceTrigger=PropertyChanged}"/>

        <StackPanel
            Grid.Row="0"
            Grid.Column="2"
            Orientation="Horizontal"
            VerticalAlignment="Center">
            <Button
                Padding="6,2"
                Margin="2,5,0,5"
                ToolTip="Row up (decrease)"
                Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.RowUpCommand}">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE70E;"/>
            </Button>
            <Button
                Padding="6,2"
                Margin="2,5"
                ToolTip="Row down (increase)"
                Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.RowDownCommand}">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE70D;"/>
            </Button>
        </StackPanel>

        <!--RowSpan-->
        <TextBlock
            Grid.Row="1"
            Grid.Column="0"
            Margin="5"
            VerticalAlignment="top"
            Text="Row Span"
            FontWeight="Bold"
            FontSize="16"/>

        <TextBox
            Grid.Row="1"
            Grid.Column="1"
            Grid.ColumnSpan="2"
            VerticalAlignment="top"
            Margin="5"
            Text="{Binding RowSpan, UpdateSourceTrigger=PropertyChanged}"/>

        <!--Column-->
        <TextBlock
            Grid.Row="2"
            Grid.Column="0"
            Margin="5"
            VerticalAlignment="top"
            Text="Column"
            FontWeight="Bold"
            FontSize="16"/>

        <TextBox
            Grid.Row="2"
            Grid.Column="1"
            VerticalAlignment="top"
            Margin="5"
            Text="{Binding Column, UpdateSourceTrigger=PropertyChanged}"/>

        <StackPanel
            Grid.Row="2"
            Grid.Column="2"
            Orientation="Horizontal"
            VerticalAlignment="Center">
            <Button
                Padding="6,2"
                Margin="2,5,0,5"
                ToolTip="Column left (decrease)"
                Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.ColumnLeftCommand}">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE76B;"/>
            </Button>
            <Button
                Padding="6,2"
                Margin="2,5"
                ToolTip="Column right (increase)"
                Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.ColumnRightCommand}">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE76C;"/>
            </Button>
        </StackPanel>

        <!--Column Span-->
        <TextBlock
            Grid.Row="3"
            Grid.Column="0"
            Margin="5"
            VerticalAlignment="top"
            Text="Column Span"
            FontWeight="Bold"
            FontSize="16"/>

        <TextBox
            Grid.Row="3"
            Grid.Column="1"
            Grid.ColumnSpan="2"
            VerticalAlignment="top"
            Margin="5"
            Text="{Binding ColumnSpan, UpdateSourceTrigger=PropertyChanged}"/>
    </Grid>
</UserControl>

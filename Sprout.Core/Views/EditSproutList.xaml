<UserControl x:Class="Sprout.Core.Views.EditSproutList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Sprout.Core.Views"
             xmlns:config="clr-namespace:Sprout.Core.Models.Configurations"
             xmlns:conv="clr-namespace:Sprout.Core.Converters"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"

             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance config:SproutListConfig}">
    <UserControl.Resources>
        <conv:NullableDoubleConverter x:Key="NullableDoubleConverter"/>
        <conv:StringToBrushConverter x:Key="StringToBrush"/>
    </UserControl.Resources>

    <Grid>
        <TabControl>
            <TabItem Header="List">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" MinWidth="150"/>
                    </Grid.ColumnDefinitions>

                    <!--Name-->
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="5"
                        VerticalAlignment="Top"
                        Text="Name"
                        FontWeight="Bold"
                        FontSize="16"/>

                    <TextBox
                        Grid.Row="0"
                        Grid.Column="1"
                        VerticalAlignment="Top"
                        Margin="5"
                        Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

                    <!--Header-->
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="5"
                        VerticalAlignment="Top"
                        Text="Header"
                        FontWeight="Bold"
                        FontSize="16"/>

                    <TextBox
                        Grid.Row="1"
                        Grid.Column="1"
                        VerticalAlignment="Top"
                        Margin="5"
                        Text="{Binding Header, UpdateSourceTrigger=PropertyChanged}"/>

                    <!--ShowBorder-->
                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        Margin="5"
                        VerticalAlignment="Center"
                        Text="Show Border"
                        FontWeight="Bold"
                        FontSize="16"/>

                    <CheckBox
                        Grid.Row="2"
                        Grid.Column="1"
                        Margin="5"
                        VerticalAlignment="Center"
                        IsChecked="{Binding ShowBorder, UpdateSourceTrigger=PropertyChanged}"/>

                    <!--Background-->
                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="0"
                        Margin="5"
                        VerticalAlignment="Center"
                        Text="Background"
                        FontWeight="Bold"
                        FontSize="16"/>

                    <Grid Grid.Row="3" Grid.Column="1" Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding Background, UpdateSourceTrigger=PropertyChanged}"/>
                        <Border Grid.Column="1"
                                Width="24" Height="24"
                                Margin="6,0,0,0"
                                Background="{Binding Background, Converter={StaticResource StringToBrush}}"
                                BorderBrush="Gray" BorderThickness="1"/>
                    </Grid>

                    <!--BorderBrush-->
                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="0"
                        Margin="5"
                        VerticalAlignment="Center"
                        Text="Border Brush"
                        FontWeight="Bold"
                        FontSize="16"/>

                    <Grid Grid.Row="4" Grid.Column="1" Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding BorderBrush, UpdateSourceTrigger=PropertyChanged}"/>
                        <Border Grid.Column="1"
                                Width="24" Height="24"
                                Margin="6,0,0,0"
                                Background="{Binding BorderBrush, Converter={StaticResource StringToBrush}}"
                                BorderBrush="Gray" BorderThickness="1"/>
                    </Grid>

                    <!--BorderThickness-->
                    <TextBlock
                        Grid.Row="5"
                        Grid.Column="0"
                        Margin="5"
                        VerticalAlignment="Top"
                        Text="Border Thickness"
                        FontWeight="Bold"
                        FontSize="16"/>

                    <TextBox
                        Grid.Row="5"
                        Grid.Column="1"
                        VerticalAlignment="Top"
                        Margin="5"
                        Text="{Binding BorderThickness, UpdateSourceTrigger=PropertyChanged}"/>

                    <!--CornerRadius-->
                    <TextBlock
                        Grid.Row="6"
                        Grid.Column="0"
                        Margin="5"
                        VerticalAlignment="Top"
                        Text="Corner Radius"
                        FontWeight="Bold"
                        FontSize="16"/>

                    <TextBox
                        Grid.Row="6"
                        Grid.Column="1"
                        VerticalAlignment="Top"
                        Margin="5"
                        Text="{Binding CornerRadius, UpdateSourceTrigger=PropertyChanged}"/>

                    <!--ShowFooter-->
                    <TextBlock
                        Grid.Row="7"
                        Grid.Column="0"
                        Margin="5"
                        VerticalAlignment="Center"
                        Text="Show Footer"
                        FontWeight="Bold"
                        FontSize="16"/>

                    <CheckBox
                        Grid.Row="7"
                        Grid.Column="1"
                        Margin="5"
                        VerticalAlignment="Center"
                        IsChecked="{Binding ShowFooter, UpdateSourceTrigger=PropertyChanged}"/>

                    <!--ShowSearch-->
                    <TextBlock
                        Grid.Row="8"
                        Grid.Column="0"
                        Margin="5"
                        VerticalAlignment="Center"
                        Text="Show Search"
                        FontWeight="Bold"
                        FontSize="16"/>

                    <CheckBox
                        Grid.Row="8"
                        Grid.Column="1"
                        Margin="5"
                        VerticalAlignment="Center"
                        IsChecked="{Binding ShowSearch, UpdateSourceTrigger=PropertyChanged}"/>

                    <!--EmptyText-->
                    <TextBlock
                        Grid.Row="9"
                        Grid.Column="0"
                        Margin="5"
                        VerticalAlignment="Top"
                        Text="Empty Text"
                        FontWeight="Bold"
                        FontSize="16"/>

                    <TextBox
                        Grid.Row="9"
                        Grid.Column="1"
                        VerticalAlignment="Top"
                        Margin="5"
                        Text="{Binding EmptyText, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
            </TabItem>

            <TabItem Header="Pages">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Margin="0,0,0,8"
                               TextWrapping="Wrap"
                               Foreground="#555"
                               Text="Pages the list can open. When at least one page is added a button appears under the header; selecting a page opens it and passes the list's selected item as the page parameter."/>

                    <!-- Add a page -->
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Column="0"
                                  VerticalContentAlignment="Center"
                                  ItemsSource="{Binding DataContext.NonMenuPages, RelativeSource={RelativeSource AncestorType=Window}}"
                                  DisplayMemberPath="Title"
                                  SelectedItem="{Binding DataContext.PageToAdd, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"/>

                        <Button Grid.Column="1"
                                Content="Add"
                                Width="70"
                                Margin="6,0,0,0"
                                Command="{Binding DataContext.AddListPageCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    </Grid>

                    <!-- Configured pages -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ListBox Grid.Column="0"
                                 ItemsSource="{Binding Pages}"
                                 HorizontalContentAlignment="Stretch"
                                 SelectedItem="{Binding DataContext.SelectedListPage, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="Menu text:"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,6,0"
                                                   Foreground="#555"/>
                                        <TextBox Grid.Column="1"
                                                 VerticalContentAlignment="Center"
                                                 Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Grid.Column="1"
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Top">
                            <Button Content="Remove"
                                    Width="70"
                                    Margin="0,0,0,4"
                                    Command="{Binding DataContext.RemoveListPageCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            <Button Content="Up"
                                    Width="70"
                                    Margin="0,0,0,4"
                                    Command="{Binding DataContext.MoveListPageUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            <Button Content="Down"
                                    Width="70"
                                    Command="{Binding DataContext.MoveListPageDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Common">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" MinWidth="150"/>
                    </Grid.ColumnDefinitions>

                    <!--Height-->
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="5"
                        VerticalAlignment="Top"
                        Text="Height"
                        FontWeight="Bold"
                        FontSize="16"/>

                    <TextBox
                        Grid.Row="0"
                        Grid.Column="1"
                        VerticalAlignment="Top"
                        Margin="5"
                        Text="{Binding Height, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NullableDoubleConverter}}"/>

                    <!--Width-->
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="5"
                        VerticalAlignment="Top"
                        Text="Width"
                        FontWeight="Bold"
                        FontSize="16"/>

                    <TextBox
                        Grid.Row="1"
                        Grid.Column="1"
                        VerticalAlignment="Top"
                        Margin="5"
                        Text="{Binding Width, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NullableDoubleConverter}}"/>

                    <!--Margin-->
                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        Margin="5"
                        VerticalAlignment="Top"
                        Text="Margin"
                        FontWeight="Bold"
                        FontSize="16"/>

                    <TextBox
                        Grid.Row="2"
                        Grid.Column="1"
                        VerticalAlignment="Top"
                        Margin="5"
                        Text="{Binding Margin, UpdateSourceTrigger=PropertyChanged}"/>

                    <!--Padding-->
                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="0"
                        Margin="5"
                        VerticalAlignment="Top"
                        Text="Padding"
                        FontWeight="Bold"
                        FontSize="16"/>

                    <TextBox
                        Grid.Row="3"
                        Grid.Column="1"
                        VerticalAlignment="Top"
                        Margin="5"
                        Text="{Binding Padding, UpdateSourceTrigger=PropertyChanged}"/>

                    <!--HorizontalAlignment-->
                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="0"
                        Margin="5"
                        VerticalAlignment="Center"
                        Text="Horizontal Alignment"
                        FontWeight="Bold"
                        FontSize="16"/>

                    <ComboBox
                        Grid.Row="4"
                        Grid.Column="1"
                        Margin="5"
                        SelectedItem="{Binding HorizontalAlignment, UpdateSourceTrigger=PropertyChanged}">
                        <sys:String>(Default)</sys:String>
                        <sys:String>Left</sys:String>
                        <sys:String>Center</sys:String>
                        <sys:String>Right</sys:String>
                        <sys:String>Stretch</sys:String>
                    </ComboBox>

                    <!--VerticalAlignment-->
                    <TextBlock
                        Grid.Row="5"
                        Grid.Column="0"
                        Margin="5"
                        VerticalAlignment="Center"
                        Text="Vertical Alignment"
                        FontWeight="Bold"
                        FontSize="16"/>

                    <ComboBox
                        Grid.Row="5"
                        Grid.Column="1"
                        Margin="5"
                        SelectedItem="{Binding VerticalAlignment, UpdateSourceTrigger=PropertyChanged}">
                        <sys:String>(Default)</sys:String>
                        <sys:String>Top</sys:String>
                        <sys:String>Center</sys:String>
                        <sys:String>Bottom</sys:String>
                        <sys:String>Stretch</sys:String>
                    </ComboBox>

                    <!--ToolTip-->
                    <TextBlock
                        Grid.Row="6"
                        Grid.Column="0"
                        Margin="5"
                        VerticalAlignment="Top"
                        Text="Tooltip"
                        FontWeight="Bold"
                        FontSize="16"/>

                    <TextBox
                        Grid.Row="6"
                        Grid.Column="1"
                        VerticalAlignment="Top"
                        Margin="5"
                        Text="{Binding ToolTip, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>

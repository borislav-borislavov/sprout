<UserControl x:Class="Sprout.Core.Views.Controls.SproutDataGrid"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
			 xmlns:local="clr-namespace:Sprout.Core.Views.Controls"
			 xmlns:conv="clr-namespace:Sprout.Core.Converters"
			 mc:Ignorable="d"
			 d:DesignHeight="450" d:DesignWidth="800" >
    <UserControl.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Border BorderThickness="0.8" BorderBrush="DarkSlateGray">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ToolBar x:Name="gridButtonsPanel"
                     Background="Transparent"
                     ToolBarTray.IsLocked="True"
                     MinHeight="35"
                     Grid.Row="0">
                <Button x:Name="btnFilters"
                        ToolTip="Filter data"
                        Style="{StaticResource FlatRoundButtonStyle}"
                        HorizontalAlignment="Left"
                        Click="btnFilters_Click"
                        Margin="2">

                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="23"/>
                </Button>

                <Rectangle Width="1" Height="20" Fill="Gray" Margin="5,0"/>

                <Button x:Name="btnInsert"
                        ToolTip="Add new row"
                        Style="{StaticResource FlatRoundButtonStyle}"
                        Visibility="{Binding Config.AllowInsert,
                                     RelativeSource={RelativeSource AncestorType=local:SproutDataGrid},
                                     Converter={StaticResource BoolToVis}}"
                        HorizontalAlignment="Left"
                        Margin="2">

                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="23"/>
                </Button>

                <Button x:Name="btnSave"
                        ToolTip="Save grid changes"
                        Style="{StaticResource FlatRoundButtonStyle}"
                        Visibility="{Binding Config.ShowSave, RelativeSource={RelativeSource AncestorType=local:SproutDataGrid}, Converter={StaticResource BoolToVis}}"
                        HorizontalAlignment="Left"
                        Margin="2">
                    <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="23"/>
                </Button>

                <Button x:Name="btnDelete"
                        ToolTip="Delete row"
                        Style="{StaticResource FlatRoundButtonStyle}"
                        Visibility="{Binding Config.AllowDelete,
                                        RelativeSource={RelativeSource AncestorType=local:SproutDataGrid},
                                        Converter={StaticResource BoolToVis}}"
                        HorizontalAlignment="Left"
                        Margin="2">
                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="23"/>
                </Button>

                <Button x:Name="btnRefresh"
                        ToolTip="Refresh data"
                        Style="{StaticResource FlatRoundButtonStyle}"
                        HorizontalAlignment="Left"
                        Margin="2">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="23"/>
                </Button>

                <Button x:Name="btnColumnSettings"
                        ToolTip="Column settings"
                        Style="{StaticResource FlatRoundButtonStyle}"
                        HorizontalAlignment="Left"
                        Click="btnColumnSettings_Click"
                        Margin="2">
                    <TextBlock Text="&#xF579;" FontFamily="Segoe MDL2 Assets" FontSize="23"/>
                </Button>

                <Button x:Name="btnRowPreview"
                        ToolTip="Preview row"
                        Style="{StaticResource FlatRoundButtonStyle}"
                        HorizontalAlignment="Left"
                        Margin="2">
                    <TextBlock Text="&#xE890;" FontFamily="Segoe MDL2 Assets" FontSize="23"/>
                </Button>

                <Rectangle Width="1" Height="20" Fill="Gray" Margin="5,0"/>

                <Button x:Name="btnLocalSearch"
                        ToolTip="Local Search"
                        Style="{StaticResource FlatRoundButtonStyle}"
                        HorizontalAlignment="Left"
                        Margin="2">
                    <TextBlock Text="&#xE773;" FontFamily="Segoe MDL2 Assets" FontSize="23"/>
                </Button>

                <Rectangle Width="1" Height="20" Fill="Gray" Margin="5,0"/>

                <Menu Background="Transparent" VerticalAlignment="Center">
                    <MenuItem ToolTip="Export data">
                        <MenuItem.Header>
                            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="23"/>
                        </MenuItem.Header>
                        <MenuItem x:Name="menuExportExcel">
                            <MenuItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Excel" VerticalAlignment="Center"/>
                                </StackPanel>
                            </MenuItem.Header>
                        </MenuItem>
                    </MenuItem>
                </Menu>

                <Menu x:Name="menuRow"
                      x:FieldModifier="public"
                      Background="Transparent"
                      VerticalAlignment="Center"
                      Visibility="Collapsed">
                    <MenuItem x:Name="menuRowRoot"
                              x:FieldModifier="public"
                              ToolTip="Open a page for the selected row">
                        <MenuItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="23"/>
                                <TextBlock Text="Row" VerticalAlignment="Center" Margin="3,0,0,0"/>
                            </StackPanel>
                        </MenuItem.Header>
                    </MenuItem>
                </Menu>
            </ToolBar>

            <Border
                x:Name="filtersBorder"
                Visibility="Collapsed"
                Grid.Row="0"
                BorderThickness="0, 0, 0 0.8"
                BorderBrush="DarkSlateGray">
                <ToolBar x:Name="filtersButtonPanel"
                         MinHeight="35"
                         Background="Transparent"
                         ToolBarTray.IsLocked="True">
                    <Button
                        ToolTip="Filter data"
                        Style="{StaticResource FlatRoundButtonStyle}"
                        HorizontalAlignment="Left"
                        Click="btnFilters_Click"
                        Margin="2">
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="23"/>
                    </Button>

                    <Rectangle Width="1" Height="20" Fill="Gray" Margin="5,0"/>

                    <Button
                        x:Name="btnApplyFilters"
                        x:FieldModifier="public"
                        ToolTip="Apply filters"
                        Style="{StaticResource FlatRoundButtonStyle}"
                        HorizontalAlignment="Left"
                        Click="btnApplyFilters_Click"
                        Margin="2">
                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="23"/>
                    </Button>
                    
                </ToolBar>
            </Border>

            <Grid x:Name="FiltersGrid"
                  Grid.Row="1"
                  Visibility="Collapsed">
                <ScrollViewer
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel Name="spFilters" x:FieldModifier="public">

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <DataGrid
              x:Name="dataGrid"
              x:FieldModifier="public"
              VirtualizingStackPanel.IsVirtualizing="True"
              VirtualizingStackPanel.VirtualizationMode="Recycling"
              EnableRowVirtualization="True"
              EnableColumnVirtualization="True"
                
              HorizontalGridLinesBrush="#E2E2E2" 
              VerticalGridLinesBrush="#E2E2E2" 
              GridLinesVisibility="All"
                
			  Grid.Row="1"
			  AutoGenerateColumns="False"
			  CanUserAddRows="False"
			  CanUserDeleteRows="False"
			  SelectionMode="Single"
			  SelectionUnit="FullRow"
			  PreviewKeyDown="dataGrid_PreviewKeyDown"
              AutoGeneratingColumn="dataGrid_AutoGeneratingColumn"
              BorderThickness="0,0.8,0,0"
              BorderBrush="DarkSlateGray" 
              HeadersVisibility="Column"
              Foreground="DarkSlateGray">
                <DataGrid.Resources>
                    <conv:RowDeletedToOpacityConverter x:Key="DeletedConverter"/>
                    <conv:RowColorConverter x:Key="RowColorConverter"/>
                </DataGrid.Resources>

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Opacity">
                            <Setter.Value>
                                <MultiBinding Converter="{StaticResource DeletedConverter}" UpdateSourceTrigger="PropertyChanged">
                                    <Binding Path="." /> <!--this triggers the converter when the view comes back in to view-->
                                    <Binding Path="[_IsDeleted]" /> <!--This triggers the converter instantly after the value changed-->
                                </MultiBinding>
                            </Setter.Value>
                        </Setter>

                        <Setter Property="Background" Value="White" />

                        <Setter Property="Background">
                            <Setter.Value>
                                <MultiBinding Converter="{StaticResource RowColorConverter}">
                                    <Binding Path="." />
                                    <Binding Path="[_RowBackColor]" />
                                </MultiBinding>
                            </Setter.Value>
                        </Setter>

                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>

            <!-- Loading overlay shown while fetching data -->
            <Border Grid.Row="1"
                    Background="#80FFFFFF"
                    Visibility="{Binding VM.IsBusy, RelativeSource={RelativeSource AncestorType=local:SproutDataGrid}, Converter={StaticResource BoolToVis}}"
                    IsHitTestVisible="True">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Loading..."
                               FontSize="14"
                               Foreground="DarkSlateGray"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" BorderThickness="0,0.8,0,0" BorderBrush="DarkSlateGray" >
                <StatusBar >
                    <StatusBar.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#F0F0F0" Offset="0"/>
                            <GradientStop Color="#D0D0D0" Offset="1"/>
                        </LinearGradientBrush>
                    </StatusBar.Background>

                    <StatusBarItem>
                        <TextBlock x:Name="txtStatusBar"
                               Text="{Binding Items.Count, ElementName=dataGrid, StringFormat={}{0:N0} rows}"
                               />
                    </StatusBarItem>
                </StatusBar>
            </Border>
        </Grid>
    </Border>
</UserControl>

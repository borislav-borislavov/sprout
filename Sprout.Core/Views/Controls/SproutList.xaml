<UserControl x:Class="Sprout.Core.Views.Controls.SproutList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Sprout.Core.Views.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="250"
             x:Name="root">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Border x:Name="border"
            x:FieldModifier="public">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header: title + optional search box -->
            <Grid Grid.Row="0" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="headerText"
                           Grid.Column="0"
                           Text="{Binding Header, ElementName=root}"
                           FontWeight="Bold"
                           FontSize="14"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="#2C3E50">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Header, ElementName=root}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Header, ElementName=root}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Border Grid.Column="1"
                        x:Name="searchBox"
                        Visibility="{Binding ShowSearch, ElementName=root, Converter={StaticResource BoolToVis}}"
                        BorderBrush="#BDC3C7"
                        BorderThickness="1"
                        CornerRadius="3"
                        Background="White"
                        Padding="4,2"
                        MinWidth="130"
                        Margin="6,0,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   FontFamily="Segoe MDL2 Assets"
                                   Text="&#xE721;"
                                   FontSize="12"
                                   Foreground="#7F8C8D"
                                   VerticalAlignment="Center"
                                   Margin="0,0,4,0"/>
                        <TextBox Grid.Column="1"
                                 x:Name="searchTextBox"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 VerticalAlignment="Center"
                                 ToolTip="Search"
                                 Text="{Binding SearchText, ElementName=root, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Page-launch menu: shown only when one or more pages are configured -->
            <Menu Grid.Row="1"
                  x:Name="pageLaunchMenu"
                  x:FieldModifier="public"
                  HorizontalAlignment="Left"
                  Margin="0,0,0,6"
                  Background="Transparent"
                  Visibility="Collapsed">
                <MenuItem x:Name="pageLaunchMenuRoot"
                          x:FieldModifier="public"
                          Padding="8,3">
                    <MenuItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE8A5;"
                                       FontSize="12"
                                       Margin="0,0,6,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Open"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </MenuItem.Header>
                </MenuItem>
            </Menu>

            <!-- Items + empty state -->
            <Grid Grid.Row="2">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ListBox x:Name="itemsControl"
                             x:FieldModifier="public"
                             BorderThickness="0"
                             Background="Transparent"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                </ScrollViewer>

                <TextBlock x:Name="emptyState"
                           Text="{Binding EmptyText, ElementName=root}"
                           Foreground="#95A5A6"
                           FontStyle="Italic"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="{Binding IsEmpty, ElementName=root, Converter={StaticResource BoolToVis}}"/>
            </Grid>

            <!-- Footer: item count -->
            <Border Grid.Row="3"
                    Margin="0,6,0,0"
                    Padding="0,4,0,0"
                    BorderBrush="#ECF0F1"
                    BorderThickness="0,1,0,0"
                    Visibility="{Binding ShowFooter, ElementName=root, Converter={StaticResource BoolToVis}}">
                <TextBlock x:Name="footerText"
                           Text="{Binding FooterText, ElementName=root}"
                           FontSize="11"
                           Foreground="#7F8C8D"
                           HorizontalAlignment="Right"/>
            </Border>
        </Grid>
    </Border>
</UserControl>

<UserControl x:Class="Sprout.Core.Views.JobsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:Sprout.Core.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000"
             d:DataContext="{d:DesignInstance viewModels:JobsVM}"
             Background="#F5F7FA">
    <UserControl.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#E8EDF3"/>
            <Setter Property="Foreground" Value="#243447"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#526273"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Jobs" FontSize="28" FontWeight="SemiBold" Foreground="#162536"/>
                <TextBlock Text="Run C# tasks on demand or on a recurring schedule." Foreground="#6B7785" Margin="0,5,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="+ New job" Command="{Binding AddCommand}"
                    Style="{StaticResource ActionButton}" Background="#2563EB" Foreground="White" Margin="0"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Background="White" CornerRadius="10" BorderBrush="#E1E7EE" BorderThickness="1" Padding="8">
                <ListBox ItemsSource="{Binding Jobs}" SelectedItem="{Binding SelectedJob}"
                         BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="12"/>
                            <Setter Property="Margin" Value="0,2"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="{Binding Status}" Foreground="#6B7785" FontSize="12" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Ellipse Grid.Column="1" Width="8" Height="8" Fill="#22C55E" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Grid.Column="2" Background="White" CornerRadius="10" BorderBrush="#E1E7EE" BorderThickness="1" Padding="24">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel DataContext="{Binding SelectedJob}">
                        <TextBlock Text="Job details" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,22"/>

                        <TextBlock Text="Name" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Padding="10,7" Margin="0,0,0,18"/>

                        <Border Background="#F7F9FC" CornerRadius="8" Padding="16" Margin="0,0,0,18">
                            <StackPanel>
                                <CheckBox Content="Run on a schedule" IsChecked="{Binding IsScheduleEnabled}"
                                          FontWeight="SemiBold" Margin="0,0,0,12"/>
                                <TextBlock Text="Cron expression" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding CronExpression, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" FontFamily="Consolas"/>
                                <TextBlock Text="Quartz cron format, e.g. '0 0/5 * * * ?' runs every 5 minutes."
                                           Foreground="#6B7785" FontSize="12" Margin="0,6,0,0"/>
                                <TextBlock Text="{Binding NextRunAt, StringFormat='Next run: {0:g}', TargetNullValue='No run scheduled'}"
                                           Foreground="#6B7785" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="#F7F9FC" CornerRadius="8" Padding="14" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="STATUS" FontSize="11" FontWeight="Bold" Foreground="#7A8795"/>
                                    <TextBlock Text="{Binding Status}" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="#F7F9FC" CornerRadius="8" Padding="14" Margin="6,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="LAST STARTED" FontSize="11" FontWeight="Bold" Foreground="#7A8795"/>
                                    <TextBlock Text="{Binding LastStartedAt, StringFormat={}{0:g}, TargetNullValue=Never}" FontSize="14" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <TextBlock Text="{Binding LastError}" Foreground="#B91C1C" TextWrapping="Wrap" Margin="0,0,0,16"/>

                        <WrapPanel DataContext="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext}">
                            <Button Content="Run now" Command="{Binding RunCommand}" Style="{StaticResource ActionButton}" Background="#16A34A" Foreground="White"/>
                            <Button Content="Stop" Command="{Binding StopCommand}" Style="{StaticResource ActionButton}" Background="#F59E0B" Foreground="White"/>
                            <Button Content="Edit script" Command="{Binding EditScriptCommand}" Style="{StaticResource ActionButton}"/>
                            <Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource ActionButton}" Background="#2563EB" Foreground="White"/>
                            <Button Content="Delete" Command="{Binding DeleteCommand}" Style="{StaticResource ActionButton}" Background="#FEE2E2" Foreground="#B91C1C"/>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>

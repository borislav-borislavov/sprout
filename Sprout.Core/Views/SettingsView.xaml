<UserControl x:Class="Sprout.Core.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Sprout.Core.Views"
             xmlns:viewModels="clr-namespace:Sprout.Core.ViewModels"
             xmlns:controls="clr-namespace:Sprout.Core.Views.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance viewModels:SettingsVM}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Settings"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="DarkSlateGray"
                   Margin="0,0,0,15"/>

        <TabControl Grid.Row="1">
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <GroupBox Header="General" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Version" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding Version, UpdateSourceTrigger=PropertyChanged}"
                                         Width="80"
                                         HorizontalAlignment="Left"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="SQL Server" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <controls:ConnectionStringBox ConnectionString="{Binding SqlServerConnectionString, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              Margin="0,0,0,10"/>

                                <TextBlock Text="Command Timeout (seconds)" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding CommandTimeout, UpdateSourceTrigger=PropertyChanged}"
                                         Width="80"
                                         HorizontalAlignment="Left"
                                         Margin="0,0,0,10"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="DuckDB" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Connection String" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding DuckDbConnectionString, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Diagnostics" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <CheckBox Content="Log every SQL query to a file (sql-queries.log)"
                                          IsChecked="{Binding LogSqlQueries}"
                                          Margin="0,0,0,5"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Seed Update">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <GroupBox Header="Seed Update Strategy" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Strategy" Margin="0,0,0,3"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <ComboBox ItemsSource="{Binding SeedUpdateStrategies}"
                                              SelectedItem="{Binding SelectedSeedUpdateStrategy}"
                                              Width="200"
                                              HorizontalAlignment="Left"/>
                                    <Button Content="Initialize"
                                            Command="{Binding InitializeStrategyCommand}"
                                            Padding="15,4"
                                            Margin="10,0,0,0"/>
                                    <Button Content="Publish"
                                            Command="{Binding PublishStrategyCommand}"
                                            Padding="15,4"
                                            Margin="10,0,0,0"/>
                                </StackPanel>

                                <ContentControl Content="{Binding SelectedSeedUpdateViewModel}">
                                    <ContentControl.Resources>
                                        <DataTemplate DataType="{x:Type viewModels:AdHocSeedUpdateVM}">
                                            <local:AdHocSeedUpdateView/>
                                        </DataTemplate>
                                    </ContentControl.Resources>
                                </ContentControl>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Button Grid.Row="2"
                Content="Save"
                Command="{Binding SaveCommand}"
                HorizontalAlignment="Left"
                Padding="20,5"
                Margin="0,15,0,0"/>
    </Grid>
</UserControl>


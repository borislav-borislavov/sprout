<Window x:Class="Sprout.Core.Windows.SeedPicker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Sprout.Core.Windows"
        xmlns:viewModels="clr-namespace:Sprout.Core.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance viewModels:SeedPickerVM}"
        Title="Pick a Seed"
        WindowStartupLocation="CenterScreen"
        Height="350"
        Width="450">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ListBox Name="lbSeeds"
                 Grid.Row="0"
                 Margin="10"
                 ItemsSource="{Binding Seeds}"
                 SelectedItem="{Binding SelectedSeed, Mode=TwoWay}"
                 HorizontalContentAlignment="Stretch"
                 MouseDoubleClick="LbSeeds_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="2">
                        <TextBlock Text="{Binding FileName}"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding RelativeFilePath}"
                                   Foreground="Gray"
                                   FontSize="11"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Orientation="Horizontal"
                    Grid.Row="1"
                    HorizontalAlignment="Right"
                    Margin="10,0,10,10">

            <Button Margin="0,0,5,0"
                    Padding="10,5"
                    MinWidth="36"
                    Content="✔"
                    Background="Transparent"
                    BorderThickness="0"
                    FontSize="16"
                    ToolTip="OK"
                    IsDefault="True"
                    Click="OkButton_Click"/>

            <Button Margin="5,0,5,0"
                    Padding="10,5"
                    MinWidth="36"
                    Content="✖"
                    Background="Transparent"
                    BorderThickness="0"
                    FontSize="16"
                    ToolTip="Cancel"
                    IsCancel="True"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
